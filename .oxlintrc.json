{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./oxlint.base.json"],
  "ignorePatterns": [
    "dist/**",
    ".wrangler/**",
    "worker-configuration.d.ts",
    "vendor/**"
  ],
  "jsPlugins": [
    {
      "name": "style",
      "specifier": "../../tools/oxlint/style/index.ts"
    }
  ],
  "rules": {
    "style/blank-line-after-block": "error"
  }
}

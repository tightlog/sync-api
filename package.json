{
  "name": "@tightlog/sync-api",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker syncing the private logbook to per-user Turso (libsql) rows (Legend State syncedCrud client in src/app).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env staging",
    "migrate": "bun run scripts/migrate.ts",
    "types": "wrangler types --env production --include-runtime=false",
    "ts:check": "bun run types && tsc --noEmit",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/backend": "3.15.0",
    "@libsql/client": "0.15.15",
    "@sentry/cloudflare": "10.67.0",
    "@tightlog/protocol": "file:./vendor/protocol",
    "@tightlog/worker-utils": "file:./vendor/worker-utils",
    "zod": "4.6.1",
    "@tightlog/app-attest": "file:./vendor/app-attest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260801.1",
    "@types/node": "25.9.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.152.0",
    "@nkzw/oxlint-config": "2.0.1",
    "@oxlint/plugins": "1.86.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003"
  }
}
